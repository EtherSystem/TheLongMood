<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>Latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Debug is useless for a mod -->
		<DebugType>none</DebugType>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<TheLongDarkPath>D:\SteamLibrary\steamapps\common\TheLongDark</TheLongDarkPath>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\Icons\Bored.png" />
	  <None Remove="Resources\Icons\ExtremelyBored.png" />
	  <None Remove="Resources\Icons\Hopeless.png" />
	  <None Remove="Resources\Icons\Miserable.png" />
	  <None Remove="Resources\Icons\Sad.png" />
	  <None Remove="Resources\Icons\VeryBored.png" />
	  <None Remove="Resources\Icons\VveryBored.png" />
	  <None Remove="Resources\Icons\Weepy.png" />
	  <None Remove="Resources\Localization\Localization.json" />
	</ItemGroup>

	<!-- List of used references -->
	<ItemGroup>
		<!-- This is the base reference. MUST EXIST -->
		<PackageReference Include="STBlade.Modding.TLD.CraftingRevisions" Version="2.2.3" />
		<PackageReference Include="STBlade.Modding.TLD.GearSpawner" Version="2.3.1" />
		<PackageReference Include="STBlade.Modding.TLD.Il2CppAssemblies.Windows" Version="2.51.0" />
		<!-- This is only if you use the ModSettings -->
		<PackageReference Include="STBlade.Modding.TLD.ModSettings" Version="1.9.0" />
		<!-- Only if you need ModData  -->
		<PackageReference Include="STBlade.Modding.TLD.ModData" Version="1.5.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<!-- Most commonly used using's. Add to this so you dont need to define them in the cs files -->
	<ItemGroup>
		<Using Include="System.Reflection" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="Il2Cpp" />
		<Using Include="HarmonyLib" />
		<Using Include="MelonLoader" />
		<Using Include="UnityEngine" />
		<Using Include="ModSettings" />
		<Using Include="ModData" />
		<Using Include="ModComponent" />
	</ItemGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>TheLongMood</AssemblyName>
		<RootNamespace>TheLongMood</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Afflictions\Patches\Effects\Patches.cs" />
		<Compile Include="Afflictions\Boredom\Bored.cs" />
		<Compile Include="Afflictions\Boredom\Extremely Bored.cs" />
		<Compile Include="Afflictions\Boredom\Very Bored.cs" />
		<Compile Include="Afflictions\Depression\Hopeless.cs" />
		<Compile Include="Afflictions\Depression\Miserable.cs" />
		<Compile Include="Afflictions\Depression\Sad.cs" />
		<Compile Include="Afflictions\Depression\Weepy.cs" />
		<Compile Include="Afflictions\Patches\FishingPatch.cs" />
		<Compile Include="Core.cs" />
		<Compile Include="ModSettings.cs" />
		<Compile Include="Afflictions\Patches\VisualPatch.cs" />
		<Compile Include="Persistence\MoodState.cs" />
		<Compile Include="Persistence\SaveDataManager.cs" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\Icons\Bored.png" />
	  <EmbeddedResource Include="Resources\Icons\ExtremelyBored.png" />
	  <EmbeddedResource Include="Resources\Icons\Hopeless.png" />
	  <EmbeddedResource Include="Resources\Icons\Miserable.png" />
	  <EmbeddedResource Include="Resources\Icons\Sad.png" />
	  <EmbeddedResource Include="Resources\Icons\VeryBored.png" />
	  <EmbeddedResource Include="Resources\Icons\Weepy.png" />
	  <EmbeddedResource Include="Resources\Localization\Localization.json" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="AfflictionComponent">
			<HintPath>$(TheLongDarkPath)\Mods\AfflictionComponent.dll</HintPath>
		</Reference>
		<Reference Include="ModComponent">
			<HintPath>$(TheLongDarkPath)\Mods\ModComponent.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- This is a build event. It will copy your dll to the currently defined TheLongDarkPath's Mods folder -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- This copies the mods files to the games mod dir -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TheLongDarkPath)/Mods" />
	</Target>
</Project>